# Run with: cmake -P CMake/Tests/test_mexext.cmake
# Load only the function under test, without MATLAB or BASIS configuration.
file (READ "${CMAKE_CURRENT_LIST_DIR}/../Basis/MatlabTools.cmake" source)
string (FIND "${source}" "function (basis_mexext)" begin)
string (SUBSTRING "${source}" ${begin} -1 source)
string (FIND "${source}" "endfunction ()" end)
math (EXPR length "${end} + 14")
string (SUBSTRING "${source}" 0 ${length} function_source)
set (function_file "${CMAKE_CURRENT_BINARY_DIR}/test_basis_mexext_function.cmake")
file (WRITE "${function_file}" "${function_source}\n")
include ("${function_file}")
file (REMOVE "${function_file}")

set (CMAKE_SYSTEM_NAME Darwin)
set (CMAKE_SIZEOF_VOID_P 8)
unset (MEX_EXT)
unset (MATLAB_MEXEXT_EXECUTABLE)
set (CMAKE_SYSTEM_PROCESSOR arm64)
basis_mexext (actual)
if (NOT actual STREQUAL "mexmaca64")
  message (FATAL_ERROR "ARM64 suffix: expected mexmaca64, got ${actual}")
endif ()
set (CMAKE_SYSTEM_PROCESSOR x86_64)
basis_mexext (actual)
if (NOT actual STREQUAL "mexmaci64")
  message (FATAL_ERROR "Intel suffix: expected mexmaci64, got ${actual}")
endif ()
set (CMAKE_SYSTEM_PROCESSOR arm64)
set (MEX_EXT "custom_suffix")
basis_mexext (actual)
if (NOT actual STREQUAL "custom_suffix")
  message (FATAL_ERROR "Explicit MEX_EXT override was not preserved")
endif ()
message (STATUS "Passed ARM64, Intel, and explicit-override MEX suffix checks")
